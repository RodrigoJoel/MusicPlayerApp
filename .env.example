# Copiá este archivo a ".env" y completá tu propia API key.
# Sin esta variable, la app funciona igual en "modo demo" con resultados de ejemplo.
#
# Cómo conseguir una key gratis: ver el README.md, sección
# "Conseguir tu YouTube Data API key".
VITE_YOUTUBE_API_KEY=

# URL del backend propio que resuelve y sirve el audio (carpeta server/).
# En desarrollo local, `cd server && npm run dev` lo levanta en este puerto.
VITE_API_BASE_URL=http://localhost:3000
